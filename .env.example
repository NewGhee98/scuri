NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Existing Drive backup OAuth client (Web application; authorised app origins).
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=
# Direct Drive import: enable Google Picker API and Drive API in the same project.
# Restrict this browser API key to your app origins and the required Google APIs.
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
# Google Cloud project NUMBER, not its textual project ID.
NEXT_PUBLIC_GOOGLE_PICKER_APP_ID=
# Optional separate Web OAuth client for Photos Picker. Falls back to the Drive client.
# Enable Photos Picker API and configure photospicker.mediaitems.readonly consent.
NEXT_PUBLIC_GOOGLE_PHOTOS_CLIENT_ID=
